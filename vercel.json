{
  "builds": [
    {
      "src": "docs/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}